# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co   # Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key                 # Safe to expose in browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key             # Server-only — never expose to client

# ── Database (direct connection for migrations / scripts) ─────────────────────
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000                    # Canonical URL; change to prod domain on deploy

# ── CLI Auth ──────────────────────────────────────────────────────────────────
CLI_JWT_SECRET=your-cli-jwt-secret-min-32-chars             # Signs CLI auth tokens issued to users

# ── OpenAI (pgvector embeddings) ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...                                        # text-embedding-3-small for session semantic search

# ── Stripe (billing) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...              # Publishable key — safe for browser
STRIPE_SECRET_KEY=sk_test_...                               # Server-only secret key
STRIPE_WEBHOOK_SECRET=whsec_...                             # From `stripe listen` or Stripe dashboard

# ── Hono API (edge) ───────────────────────────────────────────────────────────
API_BASE_PATH=/api                                          # Prefix for all Hono routes
HONO_CORS_ORIGIN=http://localhost:3000                      # Allowed CORS origin(s) for API